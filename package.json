    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
